{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unlibra-com",
  "compatibility_date": "2026-10-19",
  // Served only on the custom domain: no workers.dev URL and no Version
  // (preview) URLs, which would show the same site at a second address.
  // Both are written here because a setting left out keeps the one already
  // set on Cloudflare (docs/deploy.md).
  "workers_dev": false,
  "preview_urls": false,
  // The Worker runs only for Just HEX's share URLs (run_worker_first);
  // every other request is a static asset, served without it (and free).
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/hex/*"],
  },
}
