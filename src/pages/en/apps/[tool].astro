---
import ToolPage from "@/components/apps/ToolPage.astro";
import { toolIds, type ToolId } from "@/config/tools";

export function getStaticPaths() {
  return toolIds.map((tool) => ({ params: { tool }, props: { tool } }));
}

interface Props {
  tool: ToolId;
}

const { tool } = Astro.props;
---

<ToolPage lang="en" tool={tool} />
