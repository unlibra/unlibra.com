---
import DonateDesignPreview from "@/components/donate/donate-design-preview.astro";

// Draft routes exist only in development; the production build emits none.
export function getStaticPaths() {
  return import.meta.env.DEV
    ? [
        { params: { design: "cards" }, props: { variant: "cards" } },
        { params: { design: "rows" }, props: { variant: "rows" } },
      ]
    : [];
}

interface Props {
  variant: "cards" | "rows";
}
const { variant } = Astro.props;
---

<DonateDesignPreview variant={variant} />
