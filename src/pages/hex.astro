---
// Just HEX: the top page (/hex) with the form, and the color screen
// (/hex/#ffffff), which fills the screen with the color and hides the header
// and the footer. A click anywhere on the color opens the menu. The share
// URLs (/hex/ffffff) are this page too, served by the Worker with the
// color's OGP image (worker/index.ts); the page shows them as the hash.
// English only: there is no Japanese page.
//
// An art piece rather than a tool (the user's choice): the top page has the
// title, the input and the button only, with no description; the input's
// placeholder is its only hint, and it starts with a random color.
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import { serializeJsonLd } from "@/components/ui/json-ld";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/config/profile";
import { absoluteUrl, site } from "@/config/site";
import { layoutMessages } from "@/messages/layout";
import { hexPath, hexPattern, screenPath } from "@/config/hex";
import { hexMessages as t } from "@/messages/hex";

const webApplication = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: t.name,
  description: t.description,
  url: absoluteUrl(hexPath),
  applicationCategory: "DesignApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript. Requires HTML5.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "JPY",
  },
  author: {
    "@type": "Person",
    name: profile.name,
  },
  inLanguage: "en-US",
};

const menuItem =
  "flex min-h-11 w-full cursor-pointer items-center rounded-lg px-3 py-2.5 text-left text-base font-medium transition-colors outline-none hover:bg-gray-100 focus-visible:bg-gray-100 dark:hover:bg-atom-one-dark-lighter dark:focus-visible:bg-atom-one-dark-lighter";
---

<BaseLayout
  lang="en"
  title={`${t.name} - ${site.title}`}
  description={t.description}
  canonical={true}
>
  {/* Before the first paint: a color in the hash (or in the share URL's
      path) hides the layout, so the header never flashes, and the address
      bar shows the color as /hex/#ffffff. The module script below does the
      rest. */}
  <script
    slot="head"
    is:inline
    define:vars={{ pattern: hexPattern.source, hexPath, screenPath }}
  >
    const share = new RegExp(`^${hexPath}/([^/]+)$`).exec(location.pathname);
    const code = share ? share[1] : location.hash.slice(1);
    if (new RegExp(pattern, "i").test(code)) {
      const digits = code.replace(/^#/, "");
      history.replaceState(null, "", `${screenPath}#${digits}`);
      const root = document.documentElement;
      root.dataset.hex = "";
      root.style.setProperty("--hex", `#${digits}`);
    }
  </script>
  <div slot="screen" data-hex-screen>
    <button
      type="button"
      class="fixed inset-0 size-full cursor-pointer"
      aria-label={t.openMenu}
      aria-haspopup="dialog"
      data-hex-open
    ></button>
    <dialog
      aria-labelledby="hex-code"
      class="m-auto w-64 max-w-[calc(100%-2rem)] rounded-lg border border-gray-200 bg-white p-1 text-gray-700 shadow-lg backdrop:bg-black/20 dark:border-gray-700 dark:bg-atom-one-dark-light dark:text-gray-300"
      data-hex-menu
    >
      <p
        id="hex-code"
        class="px-3 pt-2 pb-1 font-mono text-sm text-gray-600 dark:text-gray-400"
        data-hex-code
      ></p>
      <ul>
        <li>
          <a href={hexPath} class={menuItem} data-hex-top>
            {t.menu.top}
          </a>
        </li>
        <li>
          <button type="button" class={menuItem} data-hex-copy></button>
        </li>
        <li>
          <a
            class={menuItem}
            target="_blank"
            rel="noopener noreferrer"
            data-hex-share
          >
            {t.menu.share}
          </a>
        </li>
        <li>
          <button type="button" class={menuItem} data-hex-close>
            {t.menu.close}
          </button>
        </li>
      </ul>
      <span class="sr-only" role="status" data-hex-status></span>
    </dialog>
  </div>

  <script
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(webApplication)}
  />
  <main class="mx-auto w-full max-w-7xl px-4 pt-8 pb-12 sm:px-6 lg:px-8">
    <Breadcrumb
      siteUrl={site.url}
      label={layoutMessages.en.breadcrumb.label}
      items={[{ label: t.home, href: "/" }, { label: t.name }]}
    />

    <div class="flex min-h-[60dvh] flex-col items-center justify-center gap-12 py-12">
      <h1 class="text-center font-mono text-5xl/15 font-medium tracking-tight text-gray-900 sm:text-7xl/22 dark:text-white">
        {t.name}
      </h1>

      <form class="flex items-center gap-4" novalidate data-hex-form>
        <label for="hex-input" class="sr-only">
          {t.colorCode}
        </label>
        <input
          id="hex-input"
          type="text"
          maxlength="7"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder={t.placeholder}
          aria-describedby="hex-error"
          class="w-[7.5ch] rounded-none border-b-2 border-gray-300 bg-transparent pb-1 text-center font-mono text-3xl/10 text-gray-900 outline-none placeholder:text-gray-500 focus-visible:border-primary aria-invalid:border-red-600 dark:border-gray-600 dark:text-white dark:placeholder:text-gray-400 dark:focus-visible:border-sora dark:aria-invalid:border-red-400"
          data-hex-input
        />
        <button
          type="submit"
          aria-label={t.show}
          class="flex size-14 shrink-0 cursor-pointer items-center justify-center rounded-full border border-black/15 bg-(--swatch) text-white transition-colors outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary data-[tone=light]:text-gray-900 data-empty:border-dashed data-empty:border-gray-400 data-empty:bg-transparent data-empty:text-gray-500 dark:border-white/20 dark:data-empty:text-gray-400"
          data-hex-submit
          data-empty
        >
          <ArrowRightIcon class="size-6" />
        </button>
      </form>
      <p id="hex-error" class="sr-only" role="alert" data-hex-error></p>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* The color screen: the color behind everything (the overscroll on
     phones too), in either theme, and nothing of the layout. */
  html[data-hex],
  html[data-hex] body {
    background-color: var(--hex);
  }

  html[data-hex] [data-layout],
  html:not([data-hex]) [data-hex-screen] {
    display: none;
  }

  /* A black and a white ring, so the focus shows on any color. */
  [data-hex-open]:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -6px;
    box-shadow: inset 0 0 0 3px #000;
  }

  /* A code that is not a color shakes the input (not with reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    [data-hex-input][data-shake] {
      animation: hex-shake 0.3s;
    }
  }

  @keyframes hex-shake {
    25% {
      transform: translateX(-6px);
    }
    75% {
      transform: translateX(6px);
    }
  }
</style>

<script>
  import { site } from "@/config/site";
  import {
    hexPath,
    parseHex,
    screenPath,
    screenUrl,
    sharePath,
    type Hex,
  } from "@/config/hex";
  import { hexMessages as t, withHex } from "@/messages/hex";

  const element = <T extends Element>(selector: string): T => {
    const found = document.querySelector<T>(selector);
    if (!found) throw new Error(`Just HEX: ${selector} is missing`);
    return found;
  };

  const root = document.documentElement;
  const open = element<HTMLButtonElement>("[data-hex-open]");
  const menu = element<HTMLDialogElement>("[data-hex-menu]");
  const code = element<HTMLElement>("[data-hex-code]");
  const copy = element<HTMLButtonElement>("[data-hex-copy]");
  const share = element<HTMLAnchorElement>("[data-hex-share]");
  const close = element<HTMLButtonElement>("[data-hex-close]");
  const status = element<HTMLElement>("[data-hex-status]");
  const form = element<HTMLFormElement>("[data-hex-form]");
  const input = element<HTMLInputElement>("[data-hex-input]");
  const submit = element<HTMLButtonElement>("[data-hex-submit]");
  const error = element<HTMLElement>("[data-hex-error]");
  const topTitle = document.title;

  let shown: Hex | null = null;
  let copyTimer: ReturnType<typeof setTimeout> | undefined;

  /** A random color, for the input on opening. */
  const randomHex = () =>
    Math.floor(Math.random() * 0x1000000)
      .toString(16)
      .padStart(6, "0");

  /**
   * The button takes the input's color, its arrow black or white for
   * contrast; a code that is not a color leaves it empty (dashed).
   */
  const paintButton = () => {
    const hex = parseHex(input.value);
    if (!hex) {
      submit.dataset.empty = "";
      submit.style.removeProperty("--swatch");
      delete submit.dataset.tone;
      return;
    }
    delete submit.dataset.empty;
    submit.style.setProperty("--swatch", `#${hex}`);
    const [r = 0, g = 0, b = 0] = (hex.match(/../g) ?? []).map((pair) => {
      const c = parseInt(pair, 16) / 255;
      return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
    });
    const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
    // Black or white, whichever contrasts more with the color.
    submit.dataset.tone = luminance > 0.179 ? "light" : "dark";
  };

  const setInput = (value: string) => {
    input.value = value;
    paintButton();
  };

  const setError = (invalid: boolean) => {
    error.textContent = invalid ? t.invalid : "";
    if (invalid) input.setAttribute("aria-invalid", "true");
    else input.removeAttribute("aria-invalid");
  };

  const resetCopy = () => {
    clearTimeout(copyTimer);
    if (shown) copy.textContent = withHex(t.menu.copy, shown);
    status.textContent = "";
  };

  const show = (hex: Hex | null) => {
    shown = hex;
    resetCopy();
    if (!hex) {
      menu.close();
      delete root.dataset.hex;
      root.style.removeProperty("--hex");
      document.title = topTitle;
      return;
    }
    root.dataset.hex = "";
    root.style.setProperty("--hex", `#${hex}`);
    document.title = `${withHex(t.colorTitle, hex)} - ${site.title}`;
    code.textContent = `#${hex}`;
    // Back on the top page, the input has the last color.
    setInput(`#${hex}`);
    share.href = `https://x.com/intent/post?${new URLSearchParams({
      text: t.shareText,
      url: site.url + sharePath(hex),
    })}`;
  };

  /**
   * Shows the hash's color at /hex/#ffffff; the top page is /hex. A hash
   * that is no color comes back to the form with the code in the input.
   */
  const read = () => {
    let raw = "";
    try {
      raw = decodeURIComponent(location.hash.slice(1));
    } catch {
      raw = location.hash.slice(1);
    }
    const hex = raw ? parseHex(raw) : null;
    const here = location.pathname + location.hash;
    if (hex && here !== screenUrl(hex)) {
      history.replaceState(null, "", screenUrl(hex));
    } else if (!raw && location.pathname === screenPath) {
      history.replaceState(null, "", hexPath);
    }
    if (raw && !hex) {
      setInput(raw);
      setError(true);
    }
    show(hex);
  };

  open.addEventListener("click", () => menu.showModal());
  close.addEventListener("click", () => menu.close());
  // A click on the backdrop (the dialog itself, outside its items) closes it.
  menu.addEventListener("click", (event) => {
    if (event.target === menu) menu.close();
  });
  menu.addEventListener("close", resetCopy);

  copy.addEventListener("click", async () => {
    if (!shown) return;
    resetCopy();
    try {
      await navigator.clipboard.writeText(`#${shown}`);
      copy.textContent = t.menu.copied;
      status.textContent = t.menu.copied;
      copyTimer = setTimeout(resetCopy, 2000);
    } catch (err) {
      status.textContent = t.menu.copyFailed;
      console.error("Failed to copy:", err);
    }
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const hex = parseHex(input.value);
    if (!hex) {
      setError(true);
      delete input.dataset.shake;
      void input.offsetWidth; // restarts the animation
      input.dataset.shake = "";
      input.focus();
      return;
    }
    setError(false);
    history.pushState(null, "", screenUrl(hex));
    read();
  });
  input.addEventListener("input", () => {
    setError(false);
    paintButton();
  });
  input.addEventListener("animationend", () => delete input.dataset.shake);

  // The path changes with the hash (/hex <-> /hex/#ffffff), so going back
  // and forth is a popstate; a hash typed in the address bar is a hashchange.
  window.addEventListener("popstate", read);
  window.addEventListener("hashchange", read);
  read();
  if (!shown && !input.value) setInput(`#${randomHex()}`);
</script>
