---
// A flat photo mosaic opens the remaining keyboards in place.
import { Image } from "astro:assets";
import PlusIcon from "@/components/icons/PlusIcon.astro";
import { cardRadius } from "@/components/works/card-classes";
import { coverSizes } from "@/components/works/cover-sizes";

interface Props {
  controls: string;
  count: number;
  label: string;
  previews: readonly ImageMetadata[];
}

const { controls, count, label, previews } = Astro.props;
---

<button
  type="button"
  aria-expanded="false"
  aria-controls={controls}
  class:list={[
    "group relative aspect-4/3 w-full cursor-pointer self-start overflow-hidden bg-gray-100 text-white outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-atom-one-dark-light dark:focus-visible:outline-sora",
    cardRadius,
  ]}
  data-works-more
>
  <span class="absolute inset-0 grid grid-cols-2 grid-rows-2" data-more-preview>
    {previews.map((preview) => (
      <span class="block min-h-0 min-w-0 overflow-hidden">
        <Image
          src={preview}
          alt=""
          class="size-full object-cover object-center"
          widths={[400, 600, 800, 1200]}
          sizes={coverSizes(preview, [
            ["(min-width: 1024px)", 400, "px"],
            ["(min-width: 640px)", 50, "vw"],
            [null, 100, "vw"],
          ])}
          loading="lazy"
          fetchpriority="low"
        />
      </span>
    ))}
  </span>
  <span
    class="absolute inset-0 bg-black/60 transition-colors group-hover:bg-black/70 motion-reduce:transition-none"
    aria-hidden="true"
  ></span>
  <span class="absolute inset-0 flex items-center justify-center gap-2 text-[1.75rem]/11 font-semibold">
    <span class="inline-flex items-baseline gap-0.5" data-more-count>
      <!-- Center the icon on the numeral's cap height, not the line box. -->
      <PlusIcon class="size-6 shrink-0 translate-y-[calc((1.5rem-1cap)/2)]" />
      <span>{count}</span>
    </span>
    <span>{label}</span>
  </span>
</button>
