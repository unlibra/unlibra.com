---
// The card in place of a category's other works (`shownFirst`): a button as
// large as the cards beside it, with a plus, the number of works it shows and
// what they are ("+ 4 ほかのキーボード"). A click shows them where it was
// (WorkList's script), and the focus goes to the first of them.
import PlusIcon from "@/components/icons/PlusIcon.astro";
import { cardRadius } from "@/components/works/card-classes";

interface Props {
  /** The id of the hidden works' group. */
  controls: string;
  count: number;
  label: string;
}

const { controls, count, label } = Astro.props;
---

<button
  type="button"
  aria-expanded="false"
  aria-controls={controls}
  class:list={[
    "flex min-h-40 w-full cursor-pointer flex-col items-center justify-center gap-1 bg-gray-100 text-gray-600 transition-colors outline-none hover:bg-gray-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-atom-one-dark-light dark:text-gray-400 dark:hover:bg-atom-one-dark-lighter dark:focus-visible:outline-sora",
    cardRadius,
  ]}
  data-works-more
>
  <PlusIcon class="size-6" />
  <span class="text-2xl/9 font-semibold text-gray-900 dark:text-white">
    {count}
  </span>
  <span class="text-base/6 font-medium">{label}</span>
</button>
