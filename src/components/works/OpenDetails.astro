---
// A work's title as the button that opens its dialog (the details, or the
// photo alone). The button's ::after covers the card (which needs
// `relative`), so a click anywhere on the card opens the dialog, and the
// focus ring goes around the card. Its name is the title, and the card's
// "詳しく見る" (MoreLabel) when the dialog has the details.
import type { Locale } from "@/config/locales";
import type { Work } from "@/config/works";
import { messages } from "@/messages";
import {
  cardTitleId,
  dialogId,
  moreLabelId,
  openButtonId,
} from "@/components/works/ids";

interface Props {
  lang: Locale;
  work: Work;
  /** The card has "詳しく見る": the dialog has the details. */
  more: boolean;
  class?: string;
}

const { work, lang, more, class: className } = Astro.props;
---

<button
  type="button"
  id={openButtonId(work)}
  aria-labelledby={
    more ? `${openButtonId(work)} ${moreLabelId(work)}` : undefined
  }
  aria-haspopup="dialog"
  aria-controls={dialogId(work)}
  data-work-open={work.id}
  class:list={[
    "cursor-pointer text-left outline-none after:absolute after:inset-0 after:rounded-[inherit] focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-primary",
    className,
  ]}
>
  <span id={cardTitleId(work)}>{messages[lang].works[work.id].title}</span>
</button>
