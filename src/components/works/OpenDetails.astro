---
// A work's title as the button that opens its details. The button's ::after
// covers the card (which needs `relative`), so a click anywhere on the card
// opens the details, and the focus ring goes around the card. Its name is
// the title and the card's "詳しく見る" (MoreLabel).
import type { Locale } from "@/config/locales";
import type { Work } from "@/config/works";
import { messages } from "@/messages";
import {
  cardTitleId,
  dialogId,
  moreLabelId,
  openButtonId,
} from "@/components/works/ids";

interface Props {
  lang: Locale;
  work: Work;
  class?: string;
}

const { work, lang, class: className } = Astro.props;
---

<button
  type="button"
  id={openButtonId(work)}
  aria-labelledby={`${openButtonId(work)} ${moreLabelId(work)}`}
  aria-haspopup="dialog"
  aria-controls={dialogId(work)}
  data-work-open={work.id}
  class:list={[
    "cursor-pointer text-left outline-none after:absolute after:inset-0 after:rounded-[inherit] focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-primary",
    className,
  ]}
>
  <span id={cardTitleId(work)}>{messages[lang].works[work.id].title}</span>
</button>
