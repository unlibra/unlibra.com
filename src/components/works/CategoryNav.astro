---
import { categories, type Category } from "@/config/works";
import type { Locale } from "@/config/locales";
import { messages } from "@/messages";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";

import MoonIcon from "@/components/icons/MoonIcon.astro";
import SunLowIcon from "@/components/icons/SunLowIcon.astro";
import SunHighIcon from "@/components/icons/SunHighIcon.astro";
import Sunset2Icon from "@/components/icons/Sunset2Icon.astro";

const clock = {
  keyboards: { hour: "3", Icon: MoonIcon },
  apps: { hour: "6", Icon: Sunset2Icon },
  libraries: { hour: "9", Icon: SunLowIcon },
  "vr-3d": { hour: "12", Icon: SunHighIcon },
} satisfies Record<Category, { hour: string; Icon: typeof MoonIcon }>;

interface Props {
  lang: Locale;
  /** Omitted in the hero; the section's category in the heading variant. */
  current?: Category;
}

const { lang, current } = Astro.props;
const t = messages[lang];
const focus =
  "rounded-sm outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary dark:focus-visible:outline-sora";
---

<nav aria-label={t.categoryNavigation} data-category-nav={current ?? "hero"}>
  <ul
    class:list={[
      current
        ? "flex flex-wrap items-baseline gap-x-6 gap-y-2"
        : "hero-category-list",
    ]}
  >
    {categories.map((category) => {
      const { hour, Icon: SkyIcon } = clock[category];
      return (
        <li>
          {current === category ? (
            <h2 id={`${category}-heading`} class="text-2xl font-semibold">
              <a
                href={`#${category}`}
                aria-current="location"
                class={`underline decoration-2 underline-offset-8 ${focus}`}
              >
                {t.categories[category]}
              </a>
            </h2>
          ) : current ? (
            <a
              href={`#${category}`}
              class:list={[
                "inline-block py-1 font-medium whitespace-nowrap hover:underline hover:underline-offset-4",
                "text-2xl text-gray-600 dark:text-gray-400",
                focus,
              ]}
            >
              {t.categories[category]}
            </a>
          ) : (
            <a
              href={`#${category}`}
              aria-label={t.categories[category]}
              class={`hero-category-link text-base font-medium text-gray-700 dark:text-gray-300 ${focus}`}
            >
              <span
                class="hero-category-index font-mono text-sm leading-6 text-gray-600 dark:text-gray-400"
                aria-hidden="true"
              >
                <SkyIcon class="size-4" />
                <span data-category-hour>{hour}</span>
              </span>
              <span data-category-label>{t.categories[category]}</span>
              <ArrowRightIcon class="size-4 rotate-45" />
            </a>
          )}
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .hero-category-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 24px;
    max-width: 608px;
    margin-inline: auto;
    padding-inline: 16px;
    text-align: left;
  }
  .hero-category-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16px;
    grid-template-rows: 24px 1fr;
    align-items: center;
    gap: 8px;
    height: 100%;
    padding-bottom: 12px;
    line-height: 28px;
    border-bottom: 1px solid #9bb2c1;
  }
  .hero-category-index {
    grid-column: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  [data-category-label] {
    grid-column: 1 / -1;
  }
  .hero-category-link > :global(svg) {
    grid-column: 2;
    grid-row: 1;
  }
  .hero-category-link:hover {
    border-color: currentColor;
  }
  :global(.dark) .hero-category-link {
    border-color: #8198aa;
  }
  @media (min-width: 640px) {
    .hero-category-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }
  }
  @media (max-width: 340px) {
    .hero-category-link {
      font-size: 14px;
      line-height: 24px;
    }
  }
</style>
