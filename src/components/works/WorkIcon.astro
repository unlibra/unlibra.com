---
// A work's icon: the app icons in a circle (ui-revise5 6), DiceBear "Blobs"
// that have their own background (docs/decisions/just-hex/ JH-11; no longer
// on a circle of the brand color), the npm and PyPI logos on their own
// white, with the cards' corner radius (ui-revise3 3); no border (ui-revise5
// 7).
import { Image } from "astro:assets";

import { cardRadius } from "@/components/works/card-classes";

import type { Work } from "@/config/works";

interface Props {
  work: Work;
  /** Tailwind size class, e.g. "size-10". */
  size: string;
}

const { work, size } = Astro.props;
---

{work.category === "apps" ? (
  <div
    class:list={[
      "flex shrink-0 items-center justify-center overflow-hidden rounded-full",
      size,
    ]}
  >
    <Image src={work.image} alt="" class="size-full" />
  </div>
) : (
  <div class:list={["shrink-0 overflow-hidden bg-white", cardRadius, size]}>
    {/* The logo images are 16:9 with the logo small in the middle: crop to it. */}
    <Image
      src={work.image}
      alt=""
      class="size-full scale-[2.25] object-cover"
    />
  </div>
)}
