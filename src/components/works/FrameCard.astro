---
// One frame for the photo categories (DIY Keyboards, VRChat): a 4:3 photo,
// the title, the summary and the links, without a border (ui-revise5 12).
import { Image } from "astro:assets";

import CardLinks from "@/components/works/CardLinks.astro";
import CardTitle from "@/components/works/CardTitle.astro";
import { coverSizes } from "@/components/works/cover-sizes";
import {
  cardHover,
  cardRadius,
  cardSummary,
  cardTitle,
} from "@/components/works/card-classes";
import type { Locale } from "@/config/locales";
import type { Work } from "@/config/works";
import { messages } from "@/messages";

interface Props {
  lang: Locale;
  work: Work;
}

const { work, lang } = Astro.props;
// The photo is decorative: the title is the heading next to it. It comes in
// the size it is shown at (one of 3 columns of the 7xl layout from lg, 2 from
// sm, else the full width).
const { summary } = messages[lang].works[work.id];
---

<article
  class:list={[
    "group relative flex flex-col overflow-hidden",
    cardRadius,
    cardHover,
  ]}
  data-work={work.id}
  data-card="frame"
>
  <!-- The photo: rounded on all four corners, as the More card beside it
       (the user's choice on 2026-10-28). -->
  <div
    class:list={[
      "aspect-4/3 overflow-hidden bg-gray-100 dark:bg-atom-one-dark-light",
      cardRadius,
    ]}
  >
    <Image
      src={work.image}
      alt=""
      class="size-full object-cover object-center"
      widths={[400, 600, 800, 1200]}
      sizes={coverSizes(work.image, [
        ["(min-width: 1024px)", 400, "px"],
        ["(min-width: 640px)", 50, "vw"],
        [null, 100, "vw"],
      ])}
    />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class:list={["text-lg", cardTitle]} data-work-title>
      <CardTitle work={work} lang={lang} />
    </h3>
    <p class={cardSummary} data-work-summary>
      {summary}
    </p>
    <CardLinks work={work} lang={lang} class="mt-auto" />
  </div>
</article>
