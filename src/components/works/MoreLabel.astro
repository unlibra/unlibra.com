---
// "詳しく見る" at the end of the cards that open their details: says that a
// click opens them, and is underlined on the card's hover, as the first link
// of the other cards (ui-revise5 5, 11). It is not a link, so it has no
// arrow (ui-revise4 2). It is part of the card button's name
// (aria-labelledby), so that voice control can use the visible words; it is
// hidden from screen readers here so that it is not read twice.
import {
  cardLink,
  linkText,
  primaryText,
} from "@/components/works/card-classes";
import { moreLabelId } from "@/components/works/ids";
import type { Locale } from "@/config/locales";
import type { Work } from "@/config/works";
import { messages } from "@/messages";

interface Props {
  lang: Locale;
  work: Work;
}

const { work, lang } = Astro.props;
---

<p id={moreLabelId(work)} class={cardLink} aria-hidden="true" data-work-more>
  <span class:list={[linkText, primaryText]} data-link-text>
    {messages[lang].workDetails.more}
  </span>
</p>
