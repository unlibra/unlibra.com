---
// The works of one category: the category's cards (featured works as large
// cards), and the detail dialogs of the cards that open them (DIY Keyboards,
// ui-revise4 2). A collapsed category (`shownFirst`) shows its first works,
// then a card with the number of the others, which shows them in its place.
import FeaturedCard from "@/components/works/FeaturedCard.astro";
import FrameCard from "@/components/works/FrameCard.astro";
import MoreCard from "@/components/works/MoreCard.astro";
import ToolCard from "@/components/works/ToolCard.astro";
import WorkDialog from "@/components/works/WorkDialog.astro";
import { cardTarget } from "@/components/works/work-links";
import { cardKind, cardStyles, isCollapsed, shownFirst } from "@/config/cards";
import type { Locale } from "@/config/locales";
import type { Category, Work } from "@/config/works";
import { messages } from "@/messages";

interface Props {
  lang: Locale;
  category: Category;
  works: Work[];
}

const { category, works, lang } = Astro.props;
const style = cardStyles[category];
const cards = {
  featured: FeaturedCard,
  frame: FrameCard,
  tool: ToolCard,
} satisfies Record<ReturnType<typeof cardKind>, unknown>;

// Collapsed only when it hides two works or more: a card in place of one
// work would show nothing more.
const limit = isCollapsed(category) ? shownFirst[category] : works.length;
const shown = works.length - limit >= 2 ? works.slice(0, limit) : works;
const rest = works.slice(shown.length);
const restId = `${category}-more`;
const moreLabel = isCollapsed(category)
  ? messages[lang].workDetails.moreWorks[category]
  : undefined;
---

<div
  class:list={[
    "grid grid-cols-1",
    style === "frame"
      ? "gap-6 sm:grid-cols-2 lg:grid-cols-3"
      : "gap-4 lg:grid-cols-2",
  ]}
  data-work-list={style}
>
  {shown.map((work) => {
    const Card = cards[cardKind(work)];
    return <Card work={work} lang={lang} />;
  })}
  {rest.length > 0 && moreLabel && (
    <>
      <MoreCard controls={restId} count={rest.length} label={moreLabel} />
      {/* `contents`: the hidden works are cards of the same grid. */}
      <div id={restId} class="contents" hidden data-works-rest>
        {rest.map((work) => {
          const Card = cards[cardKind(work)];
          return <Card work={work} lang={lang} />;
        })}
      </div>
    </>
  )}
</div>
{works
  .filter((work) => cardTarget(work, lang).kind !== "link")
  .map((work) => (
    <WorkDialog work={work} lang={lang} />
  ))}

<style is:global>
  /* The page behind an open dialog does not scroll. */
  html:has(dialog[data-work-dialog][open]) {
    overflow: hidden;
  }
</style>

<script>
  // The card with the number of the other works shows them in its place, and
  // the focus goes on to the first of them.
  for (const more of document.querySelectorAll<HTMLButtonElement>(
    "[data-works-more]",
  )) {
    const rest = document.getElementById(
      more.getAttribute("aria-controls") ?? "",
    );
    if (!rest) throw new Error("no works for the More card");
    more.addEventListener("click", () => {
      rest.hidden = false;
      more.setAttribute("aria-expanded", "true");
      more.hidden = true;
      rest
        .querySelector<HTMLElement>("[data-work-open], [data-work-link]")
        ?.focus();
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-work-open]",
  )) {
    const dialog = document.getElementById(
      button.getAttribute("aria-controls") ?? "",
    );
    if (!(dialog instanceof HTMLDialogElement)) {
      throw new Error(`no dialog for ${button.dataset.workOpen}`);
    }
    button.addEventListener("click", () => dialog.showModal());
  }

  for (const dialog of document.querySelectorAll<HTMLDialogElement>(
    "dialog[data-work-dialog]",
  )) {
    dialog.addEventListener("click", (event) => {
      const target = event.target as Element;
      // A click on the dialog element itself is on the backdrop: the
      // content fills the dialog.
      if (target === dialog || target.closest("[data-work-close]")) {
        dialog.close();
      }
    });
  }
</script>
