---
// A list item for Apps and Libraries: the former tool site's card (its hover,
// padding and icon background), with the icon beside the text so that the
// row reads as one work (ui-revise3 3). The whole card links to the work
// (ui-revise4 2).
import CardLinks from "@/components/works/CardLinks.astro";
import CardTitle from "@/components/works/CardTitle.astro";
import WorkIcon from "@/components/works/WorkIcon.astro";
import {
  cardHover,
  cardRadius,
  cardSummary,
  cardTitle,
} from "@/components/works/card-classes";
import type { Locale } from "@/config/locales";
import type { Work } from "@/config/works";
import { messages } from "@/messages";

interface Props {
  lang: Locale;
  work: Work;
}

const { work, lang } = Astro.props;
---

<article
  class:list={[
    "group relative grid grid-cols-[3rem_minmax(0,1fr)] gap-x-4 gap-y-2 p-4 sm:grid-rows-[auto_1fr_auto]",
    cardRadius,
    cardHover,
  ]}
  data-work={work.id}
  data-card="tool"
>
  <WorkIcon work={work} size="size-12 sm:row-span-3" />
  <h3
    class:list={["min-w-0 self-center text-lg sm:self-start", cardTitle]}
    data-work-title
  >
    <CardTitle work={work} lang={lang} />
  </h3>
  <p class:list={["col-span-2 sm:col-span-1", cardSummary]} data-work-summary>
    {messages[lang].works[work.id].summary}
  </p>
  <CardLinks
    work={work}
    lang={lang}
    class="col-span-2 self-end sm:col-span-1 sm:col-start-2"
  />
</article>
