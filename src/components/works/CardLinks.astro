---
// The links at the end of a card. A card that opens its details ends with
// "詳しく見る". A card that is a link shows all its links as actions, the
// one the card goes to first (ui-revise5 9, 11); they are in front of the
// title link's overlay, so that a click on them goes there. A card that
// opens the photo alone has neither.
import ArrowUpRightIcon from "@/components/icons/ArrowUpRightIcon.astro";
import MoreLabel from "@/components/works/MoreLabel.astro";
import {
  actionArrow,
  actionText,
  cardLink,
  focusRing,
  linkText,
  primaryText,
} from "@/components/works/card-classes";
import { cardTitleId } from "@/components/works/ids";
import { cardTarget } from "@/components/works/work-links";
import type { Locale } from "@/config/locales";
import type { Work } from "@/config/works";

interface Props {
  lang: Locale;
  work: Work;
  class?: string;
}

const { work, lang, class: className } = Astro.props;
const target = cardTarget(work, lang);
const actions = target.kind === "link" ? target.actions : [];
---

{target.kind !== "photo" && (
  <div
    class:list={["flex flex-wrap items-center gap-x-4 gap-y-2", className]}
    data-work-links
  >
    {actions.map((action, i) => (
      <a
        href={action.href}
        target={action.external ? "_blank" : undefined}
        rel={action.external ? "noopener noreferrer" : undefined}
        aria-describedby={cardTitleId(work)}
        class:list={[
          "group/link relative z-10 rounded-sm",
          cardLink,
          focusRing,
        ]}
        data-work-action={i === 0 ? "primary" : "secondary"}
      >
        <span
          class:list={[linkText, actionText, i === 0 && primaryText]}
          data-link-text
        >
          {action.label}
        </span>
        <ArrowUpRightIcon class={actionArrow} />
      </a>
    ))}
    {target.kind === "details" && <MoreLabel work={work} lang={lang} />}
  </div>
)}
