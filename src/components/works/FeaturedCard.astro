---
// A featured work (`featured: true`): a large card on a light gray surface,
// with the image inset on it (design 4 of the mock, in light gray;
// ui-revise5). The text starts with the title. Full width with the image and
// the summary side by side; in Apps, half the width with the summary under
// the image, so that two large cards share a row (2026-11-08).
import { Image } from "astro:assets";

import CardLinks from "@/components/works/CardLinks.astro";
import CardTitle from "@/components/works/CardTitle.astro";
import { coverSizes } from "@/components/works/cover-sizes";
import WorkIcon from "@/components/works/WorkIcon.astro";
import {
  cardRadius,
  cardSummaryType,
  cardTitle,
  featuredMuted,
  featuredSurface,
} from "@/components/works/card-classes";
import { isHalfFeatured, isPhoto } from "@/config/cards";
import type { Locale } from "@/config/locales";
import type { Work } from "@/config/works";
import { messages } from "@/messages";

interface Props {
  lang: Locale;
  work: Work;
}

const { work, lang } = Astro.props;
// The photo is decorative: the title is the heading next to it. It is the
// largest image above the fold (the LCP element), so it loads first, in the
// size it is shown at (half of the 7xl layout from md, else the full width).
const { summary } = messages[lang].works[work.id];
const photo = isPhoto(work.category);
const half = isHalfFeatured(work.category);
---

<article
  class:list={[
    "group relative grid gap-4 overflow-hidden p-4 sm:p-6",
    half ? "content-start" : "col-span-full md:grid-cols-2 md:gap-6",
    cardRadius,
    featuredSurface,
  ]}
  data-work={work.id}
  data-work-category={work.category}
  data-card="featured"
>
  <div
    class:list={[
      "flex aspect-4/3 items-center justify-center overflow-hidden bg-white dark:bg-atom-one-dark",
      cardRadius,
    ]}
  >
    {photo ? (
      <Image
        src={work.image}
        alt=""
        class="size-full object-cover object-center"
        widths={[400, 600, 800, 1200]}
        sizes={coverSizes(work.image, [
          ["(min-width: 768px)", 600, "px"],
          [null, 100, "vw"],
        ])}
        loading="eager"
        fetchpriority="high"
      />
    ) : work.category === "apps" ? (
      // An app's icon fills the frame as a photo does, not in its circle
      // (just-hex JH-14). An SVG: no resized copies.
      <Image
        src={work.image}
        alt=""
        class="size-full object-cover object-center"
        loading="eager"
      />
    ) : (
      <>
        {/* 60% of the frame's height, so that the icon holds the space as a
            photo does (112px until just-hex JH-13). */}
        <WorkIcon work={work} size="aspect-square h-3/5" />
      </>
    )}
  </div>
  <div class:list={["flex flex-col justify-center gap-4", !half && "md:p-4"]}>
    <h3
      class:list={["text-2xl md:text-[1.75rem]/11 lg:text-4xl", cardTitle]}
      data-work-title
    >
      <CardTitle work={work} lang={lang} />
    </h3>
    <p class:list={[cardSummaryType, featuredMuted]} data-work-summary>
      {summary}
    </p>
    <CardLinks work={work} lang={lang} />
  </div>
</article>
