---
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import { serializeJsonLd } from "@/components/ui/json-ld";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/config/locales";
import { profile } from "@/config/profile";
import { absoluteUrl, localizedPath, paths, site } from "@/config/site";
import { toolPath, type ToolId } from "@/config/tools";
import { layoutMessages } from "@/messages/layout";
import FaviconGenerator from "@/tools/favicon-generator/favicon-generator";
import { toolMessages } from "@/tools/messages";
import PasswordGenerator from "@/tools/password-generator/password-generator";
import SvgOptimizer from "@/tools/svg-optimizer/svg-optimizer";

interface Props {
  lang: Locale;
  tool: ToolId;
}

const { lang, tool } = Astro.props;
const { name, description } = toolMessages[lang].tools[tool];
// The description's line break, in one line: nothing between Japanese
// sentences, a space between English ones.
const oneLine = description.replace(/\r?\n/g, lang === "ja" ? "" : " ");

// Width of the tool area, as on the former tool pages.
const widths: Record<ToolId, string> = {
  "favicon-generator": "max-w-screen-lg",
  "svg-optimizer": "max-w-screen-lg",
  "password-generator": "max-w-screen-sm",
};

const webApplication = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name,
  description: description.replace(/\r?\n/g, " "),
  url: absoluteUrl(toolPath(tool, lang)),
  applicationCategory: "DesignApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript. Requires HTML5.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "JPY",
  },
  author: {
    "@type": "Person",
    name: profile.name,
  },
  inLanguage: lang === "ja" ? "ja-JP" : "en-US",
};
---

<BaseLayout
  lang={lang}
  title={`${name} - ${site.title}`}
  description={oneLine}
  canonical={true}
  pagePath={toolPath(tool, "ja")}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(webApplication)}
  />
  <main class="mx-auto w-full max-w-7xl px-4 pt-8 pb-12 sm:px-6 lg:px-8">
    <Breadcrumb
      siteUrl={site.url}
      label={layoutMessages[lang].breadcrumb.label}
      items={[
        {
          label: layoutMessages[lang].breadcrumb.home,
          href: localizedPath(paths.home, lang),
        },
        { label: name },
      ]}
    />

    <div class:list={["mx-auto", widths[tool]]}>
      <div class="mb-8 space-y-4">
        <h1 class="text-2xl font-semibold sm:text-[1.75rem]/11">{name}</h1>
        <p class="leading-7 whitespace-pre-line text-gray-600 dark:text-gray-400">
          {description}
        </p>
      </div>

      {/* Each island is referenced statically so that Astro can hydrate it. */}
      {tool === "favicon-generator" && (
        <FaviconGenerator client:load locale={lang} />
      )}
      {tool === "svg-optimizer" && <SvgOptimizer client:load locale={lang} />}
      {tool === "password-generator" && (
        <PasswordGenerator client:load locale={lang} />
      )}
    </div>
  </main>
</BaseLayout>
