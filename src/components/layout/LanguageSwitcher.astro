---
// The globe opens the same disclosure-style popover as the theme control.
// Language names stay in their native language; both links retain this
// page's query and section. Pages with no translation omit the control.
import WorldIcon from "@/components/icons/WorldIcon.astro";
import { locales, type Locale } from "@/config/locales";
import type { SitePath } from "@/config/site";
import { layoutMessages, localeNames } from "@/messages/layout";

interface Props {
  lang: Locale;
  /** Paths of this page in each language. */
  paths: Record<Locale, SitePath>;
}

const { lang, paths } = Astro.props;
const t = layoutMessages[lang].language;
---

<div
  class="relative"
  data-popover
  data-language-selector
  data-mobile-inline
  role="group"
  aria-label={t.label}
>
  <p
    class="hidden text-sm/6 text-gray-600 dark:text-gray-400"
    data-inline-label
  >
    {t.label}
  </p>
  <button
    type="button"
    class="flex cursor-pointer items-center justify-center rounded-full p-3 transition-colors outline-none hover:bg-black/5 focus-visible:bg-black/5 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
    aria-label={t.toggle}
    title={t.toggle}
    aria-expanded="false"
    aria-controls="language-menu"
    data-popover-button
    data-language-switch
    data-current-label={localeNames[lang]}
  >
    <WorldIcon class="size-5" />
  </button>
  <div
    id="language-menu"
    class="absolute right-0 z-50 mt-2 w-32 overflow-hidden rounded-lg border border-gray-200 bg-white p-1 shadow-lg dark:border-gray-700 dark:bg-atom-one-dark-light"
    data-popover-panel
    hidden
  >
    {locales.map((locale) => (
      <a
        href={paths[locale]}
        hreflang={locale}
        lang={locale}
        aria-current={lang === locale ? "page" : undefined}
        class="block rounded-lg px-3 py-2.5 text-base font-medium whitespace-nowrap outline-none hover:bg-gray-100 focus-visible:bg-gray-100 aria-[current=page]:bg-primary/10 dark:hover:bg-atom-one-dark-lighter dark:focus-visible:bg-atom-one-dark-lighter dark:aria-[current=page]:bg-atom-one-dark-lighter"
        data-popover-item
        data-language-option
      >
        {localeNames[locale]}
      </a>
    ))}
  </div>
</div>

<script>
  import { setupPopover } from "@/scripts/popover";

  for (const selector of document.querySelectorAll<HTMLElement>(
    "[data-language-selector]",
  )) {
    const popover = setupPopover(selector);
    for (const link of selector.querySelectorAll<HTMLAnchorElement>(
      "[data-language-option]",
    )) {
      const page = link.pathname;
      // A page that changes its address in place (the color swatch book's
      // palettes) sets the other language's path in data-path.
      const follow = () => {
        link.href =
          (link.dataset.path ?? page) + location.search + location.hash;
      };
      for (const type of ["pointerdown", "focus", "click"]) {
        link.addEventListener(type, follow);
      }
      link.addEventListener("click", (event) => {
        if (
          link.hasAttribute("aria-current") &&
          event.button === 0 &&
          !event.ctrlKey &&
          !event.metaKey &&
          !event.shiftKey &&
          !event.altKey
        ) {
          event.preventDefault();
          popover.close(true);
        }
      });
    }
  }
</script>
