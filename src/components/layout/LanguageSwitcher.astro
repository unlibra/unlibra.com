---
// The language switch: a link straight to this page in the other language
// (no menu), with the world icon and that language's name, written in that
// language ("English" on the Japanese pages, "日本語" on the English ones).
// A rounded button without a border (the user's choice on 2026-10-28), with a
// background on hover. 36px high, its target 44px (the ::before, DESIGN.md
// 5.4). Pages without the other language (the privacy policy) have no switch.
import WorldIcon from "@/components/icons/WorldIcon.astro";
import type { Locale } from "@/config/locales";
import type { SitePath } from "@/config/site";
import { localeNames } from "@/messages/layout";

interface Props {
  lang: Locale;
  /** Paths of this page in each language. */
  paths: Record<Locale, SitePath>;
}

const { lang, paths } = Astro.props;
const target: Locale = lang === "ja" ? "en" : "ja";
---

<a
  href={paths[target]}
  hreflang={target}
  lang={target}
  class="relative flex h-9 shrink-0 items-center gap-1 rounded-full px-2.5 text-base font-medium whitespace-nowrap transition-colors outline-none before:absolute before:-inset-y-1 before:inset-x-0 hover:bg-black/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:hover:bg-white/5 dark:focus-visible:outline-sora"
  data-language-switch
>
  <WorldIcon class="size-5 shrink-0" />
  {localeNames[target]}
</a>

<script>
  // The other language at the same place: the section (/#apps -> /en#apps)
  // and the query (Just HEX's /hex?invalid=zzz) go along. Set just before
  // the link is used (a press, a middle click, the context menu, keyboard
  // focus), since the page changes them without reloading.
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "[data-language-switch]",
  )) {
    const page = link.pathname;
    const follow = () => {
      link.href = page + location.search + location.hash;
    };
    for (const type of ["pointerdown", "focus", "click"]) {
      link.addEventListener(type, follow);
    }
  }
</script>
