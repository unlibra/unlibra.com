---
import MobileMenu from "@/components/layout/MobileMenu.astro";
import type { Locale } from "@/config/locales";
import { localizedPath, paths } from "@/config/site";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
  variant: "desktop" | "mobile";
}

const { lang, variant } = Astro.props;
const t = layoutMessages[lang].navigation;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const home = localizedPath(paths.home, lang);
const apps = localizedPath(paths.tools, lang);
const links = [
  { href: home, label: t.works, active: currentPath === home },
  {
    href: apps,
    label: t.apps,
    active: currentPath === apps || currentPath.startsWith(`${apps}/`),
  },
];
---

{variant === "desktop" ? (
  <div
    class="hidden items-center gap-1 md:flex lg:gap-2"
    data-desktop-navigation
  >
    {links.map(({ href, label, active }) => (
      <a
        href={href}
        aria-current={active ? "location" : undefined}
        class="rounded-lg px-3 py-3 text-base font-medium text-gray-600 transition-colors outline-none hover:bg-black/5 focus-visible:bg-black/5 aria-[current]:text-primary dark:text-gray-400 dark:hover:bg-white/5 dark:focus-visible:bg-white/5 dark:aria-[current]:text-white"
      >
        {label}
      </a>
    ))}
  </div>
) : (
  <MobileMenu lang={lang} links={links} />
)}
