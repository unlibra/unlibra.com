---
// Mobile menu: the slide-in panel of the former tool site, as a
// native <dialog> (focus stays inside, Escape closes it).
import BrandSymbol from "@/components/BrandSymbol.astro";
import Logotype from "@/components/layout/Logotype.astro";
import MenuIcon from "@/components/icons/MenuIcon.astro";
import XIcon from "@/components/icons/XIcon.astro";
import type { Locale } from "@/config/locales";
import { localizedPath, paths } from "@/config/site";
import { categories, categoryHref } from "@/config/works";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = layoutMessages[lang].header;
const iconButton =
  "flex cursor-pointer items-center justify-center rounded-lg p-2.5 transition outline-none hover:bg-black/5 focus-visible:bg-black/5 active:bg-black/10 dark:hover:bg-white/5 dark:focus-visible:bg-white/5 dark:active:bg-white/10";
const item =
  "block rounded-lg px-3 py-2.5 transition-colors outline-none hover:bg-gray-100 focus-visible:bg-gray-100 dark:hover:bg-atom-one-dark-lighter dark:focus-visible:bg-atom-one-dark-lighter";
---

<div class:list={["z-10 lg:hidden", className]} data-mobile-menu>
  <button
    type="button"
    class={iconButton}
    aria-label={t.openMenu}
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-mobile-menu-open
  >
    <MenuIcon class="size-6" />
  </button>

  <dialog
    id="mobile-menu"
    aria-label={t.menu}
    class="fixed inset-y-0 right-auto left-0 m-0 h-full max-h-none w-[85vw] max-w-sm -translate-x-full overflow-y-auto bg-white p-0 text-gray-700 shadow-xl transition-[translate,display,overlay] transition-discrete duration-300 ease-out backdrop:bg-black/20 open:translate-x-0 starting:open:-translate-x-full dark:bg-atom-one-dark-light dark:text-gray-300 dark:backdrop:bg-black/40"
  >
    <div class="min-h-full px-4 py-4">
      <div class="flex items-center justify-between">
        <a
          href={localizedPath(paths.home, lang)}
          class="flex items-center gap-2 text-xl/7"
        >
          <BrandSymbol class="size-6" />
          <!-- Up 1px to center on the symbol, as in the header. -->
          <span class="-translate-y-px" data-logotype>
            <Logotype />
          </span>
        </a>
        <button
          type="button"
          class={iconButton}
          aria-label={t.closeMenu}
          data-mobile-menu-close
        >
          <XIcon class="size-6" />
        </button>
      </div>
      <ul class="mt-6 space-y-1">
        {categories.map((category) => (
          <li>
            <a href={categoryHref(category, lang)} class={item}>
              <div class="text-base font-medium">{t.categories[category]}</div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </dialog>
</div>

<style is:global>
  /* The page behind the open menu does not scroll. */
  html:has(#mobile-menu[open]) {
    overflow: hidden;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-mobile-menu]",
  )) {
    const dialog = root.querySelector("dialog");
    const button = root.querySelector<HTMLElement>("[data-mobile-menu-open]");
    if (!dialog || !button) throw new Error("mobile menu is incomplete");

    button.addEventListener("click", () => {
      dialog.showModal();
      button.setAttribute("aria-expanded", "true");
    });
    dialog.addEventListener("close", () => {
      button.setAttribute("aria-expanded", "false");
    });
    dialog.addEventListener("click", (event) => {
      const target = event.target as Element;
      // The backdrop (a click on the dialog itself), the close button, or a
      // link (a section link stays on the same page).
      if (
        target === dialog ||
        target.closest("[data-mobile-menu-close]") ||
        target.closest("a")
      ) {
        dialog.close();
      }
    });
  }
</script>
