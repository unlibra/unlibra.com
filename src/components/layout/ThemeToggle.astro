---
import MoonIcon from "@/components/icons/MoonIcon.astro";
import SunIcon from "@/components/icons/SunIcon.astro";
import DeviceDesktopIcon from "@/components/icons/DeviceDesktopIcon.astro";
import type { Locale } from "@/config/locales";
import { themePreferences } from "@/config/theme";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = layoutMessages[lang].theme;
const icons = { light: SunIcon, dark: MoonIcon, system: DeviceDesktopIcon };
---

<div
  class="relative"
  data-popover
  data-theme-toggle
  data-mobile-inline
  role="group"
  aria-label={t.label}
>
  <p
    class="hidden text-sm/6 text-gray-600 dark:text-gray-400"
    data-inline-label
  >
    {t.label}
  </p>
  <button
    type="button"
    class="flex cursor-pointer items-center justify-center rounded-full p-3 transition-colors outline-none hover:bg-black/5 focus-visible:bg-black/5 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
    aria-label={t.toggle}
    aria-expanded="false"
    aria-controls="theme-menu"
    data-popover-button
  >
    <SunIcon class="size-5 dark:hidden" />
    <MoonIcon class="hidden size-5 dark:block" />
  </button>
  <div
    id="theme-menu"
    class="absolute right-0 z-50 mt-2 w-32 overflow-hidden rounded-lg border border-gray-200 bg-white p-1 shadow-lg dark:border-gray-700 dark:bg-atom-one-dark-light"
    data-popover-panel
    hidden
  >
    {themePreferences.map((preference) => {
      const Icon = icons[preference];
      return (
        <button
          type="button"
          class="w-full cursor-pointer rounded-lg px-3 py-2.5 text-left text-base transition-colors outline-none hover:bg-gray-100 focus-visible:bg-gray-100 aria-pressed:bg-primary/10 dark:hover:bg-atom-one-dark-lighter dark:focus-visible:bg-atom-one-dark-lighter dark:aria-pressed:bg-atom-one-dark-lighter"
          aria-label={t[preference]}
          title={t[preference]}
          aria-pressed="false"
          data-popover-item
          data-theme-option={preference}
        >
          <span class="hidden" data-theme-option-icon aria-hidden="true">
            <Icon class="size-5" />
          </span>
          <span data-theme-option-label>{t[preference]}</span>
        </button>
      );
    })}
  </div>
</div>

<script>
  import { setupPopover } from "@/scripts/popover";
  import {
    applyPreference,
    readPreference,
    savePreference,
    watchPreference,
  } from "@/scripts/theme";
  import type { ThemePreference } from "@/config/theme";

  // Kept in memory so the choice applies to this page even if it cannot be
  // saved.
  let current: ThemePreference = readPreference();

  const toggles = document.querySelectorAll<HTMLElement>("[data-theme-toggle]");
  const options = () =>
    document.querySelectorAll<HTMLElement>("[data-theme-option]");

  const render = () => {
    for (const toggle of toggles) {
      const button = toggle.querySelector<HTMLButtonElement>(
        "[data-popover-button]",
      );
      const label = toggle
        .querySelector<HTMLElement>(`[data-theme-option="${current}"]`)
        ?.textContent?.trim();
      if (!button || !label) throw new Error("theme label is missing");
      button.dataset.currentLabel = label;
    }
    for (const option of options()) {
      option.setAttribute(
        "aria-pressed",
        String(option.dataset.themeOption === current),
      );
    }
  };

  const select = (preference: ThemePreference) => {
    current = preference;
    savePreference(preference);
    applyPreference(preference);
    render();
  };

  for (const toggle of toggles) {
    const popover = setupPopover(toggle);
    toggle.addEventListener("click", (event) => {
      const option = (event.target as Element).closest<HTMLElement>(
        "[data-theme-option]",
      );
      if (!option) return;
      select(option.dataset.themeOption as ThemePreference);
      popover.close(true);
    });
  }

  render();
  watchPreference(
    () => current,
    (preference) => {
      current = preference;
      applyPreference(preference);
      render();
    },
  );
</script>
