---
// Footer: the layout of the former tool site's footer.
import BrandSymbol from "@/components/BrandSymbol.astro";
import Logotype from "@/components/layout/Logotype.astro";
import type { Locale } from "@/config/locales";
import { copyrightNotice, localizedPath, paths, site } from "@/config/site";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = layoutMessages[lang].footer;
// The links: 20px lines with 2px above and below, 24px targets (DESIGN.md
// 5.4); 4px between them keeps the former 28px steps.
const link =
  "block w-fit py-0.5 text-sm text-gray-600 transition-all hover:underline dark:text-gray-400";
const heading = "mb-3 text-sm font-semibold tracking-wider uppercase";

// The build year ends the copyright notice (design doc 3.7).
const copyright = copyrightNotice(new Date().getFullYear());

const externalLinks = [
  { href: site.links.github, label: t.github },
  { href: site.links.docs, label: t.docs },
  { href: site.links.booth, label: t.shop },
];
---

<footer class="bg-gray-100 py-12 dark:bg-atom-one-dark-light">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Four columns, 2:1:1 (ui-revise4 3); one column when narrow, as on
         the former tool site. -->
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4 lg:gap-12">
      <!-- Left (two columns): logo, site name and description -->
      <div class="md:col-span-2" data-footer-brand>
        <a
          href={localizedPath(paths.home, lang)}
          class="inline-flex items-center gap-2 transition-all hover:underline"
        >
          <BrandSymbol class="size-6" />
          <!-- Up 1px to center on the symbol, as in the header. -->
          <span class="-translate-y-px text-xl/7" data-logotype>
            <Logotype />
          </span>
        </a>
        <p class="mt-3 text-sm leading-6 whitespace-pre-line text-gray-600 dark:text-gray-400">
          {t.description}
        </p>
      </div>

      <!-- Links (where the former site listed the tools) -->
      <div data-footer-links>
        <h2 class={heading}>{t.links}</h2>
        <ul class="space-y-1">
          {externalLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class={link}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: information (the donate page, the privacy policy and the
           credits), all on this site -->
      <div data-footer-information>
        <h2 class={heading}>{t.information}</h2>
        <ul class="space-y-1">
          <li>
            <a href={localizedPath(paths.donate, lang)} class={link}>
              {t.donate}
            </a>
          </li>
          <!-- Japanese only, in every language (its exact wording) -->
          <li>
            <a
              href={paths.privacy}
              hreflang={lang === "ja" ? undefined : "ja"}
              class={link}
            >
              {t.privacyPolicy}
            </a>
          </li>
          <li>
            <a href={localizedPath(paths.credits, lang)} class={link}>
              {t.credits}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="mt-8 text-sm text-gray-600 dark:text-gray-400">{copyright}</p>
  </div>
</footer>
