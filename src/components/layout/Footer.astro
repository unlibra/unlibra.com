---
// Shared footer: profile channels below the description, then information.
import BrandSymbol from "@/components/BrandSymbol.astro";
import Logotype from "@/components/layout/Logotype.astro";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import BrandYouTubeIcon from "@/components/icons/BrandYouTubeIcon.astro";
// Official white asset, copied without recoloring or trimming:
// https://pixiv1.app.box.com/s/yj9ymvhbnpcbj22vfkkzctugzv46cnos/file/1954332587470
import booth from "@/assets/booth.svg";
import type { Locale } from "@/config/locales";
import { copyrightNotice, localizedPath, paths, site } from "@/config/site";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = layoutMessages[lang].footer;
// The links: 20px lines with 2px above and below, 24px targets (DESIGN.md
// 5.4); 4px between them keeps the former 28px steps.
const link =
  "block w-fit py-0.5 text-sm text-[#c7cbd3] transition-all hover:underline";
const heading = "mb-3 text-sm font-semibold tracking-wider uppercase";

// The build year ends the copyright notice.
const copyright = copyrightNotice(new Date().getFullYear());

const channel =
  "flex size-11 items-center justify-center rounded-full text-white transition-colors hover:bg-white/[0.08] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sora";
---

<footer class="site-footer bg-atom-one-dark-light py-12 text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[2fr_1fr] lg:gap-12">
      <div class="md:row-span-2" data-footer-brand>
        <a
          href={localizedPath(paths.home, lang)}
          class="inline-flex items-center gap-2 transition-all hover:underline"
        >
          <BrandSymbol class="size-6" />
          <!-- Up 1px to center on the symbol, as in the header. -->
          <span class="-translate-y-px text-xl/7" data-logotype>
            <Logotype />
          </span>
        </a>
        <p class="mt-3 max-w-xl text-sm leading-6 whitespace-pre-line text-[#c7cbd3]">
          {t.description}
        </p>
        <nav
          class="-ml-2.5 mt-3 flex w-fit gap-1"
          aria-label={t.channels}
          data-footer-links
        >
          <!-- GitHub: 24px mark + 6px clear space on each side (25%).
               BOOTH: 24px mark + 6px clear space on each side (0.25B).
               Both fit inside these 44px targets with 10px on each side. -->
          <a
            href={site.links.github}
            aria-label={t.github}
            title={t.github}
            target="_blank"
            rel="noopener noreferrer"
            class={channel}
          >
            <GitHubIcon class="size-6" />
          </a>
          <a
            href={site.links.booth}
            aria-label={t.shop}
            title={t.shop}
            target="_blank"
            rel="noopener noreferrer"
            class={channel}
          >
            <img src={booth.src} alt="" width="24" height="24" />
          </a>
          <a
            href={site.links.youtube}
            aria-label={t.youtube}
            title={t.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class={channel}
          >
            <BrandYouTubeIcon class="size-6" />
          </a>
        </nav>
      </div>

      <!-- Right: information (the donate page, the privacy policy and the
           credits), all on this site -->
      <div data-footer-information>
        <h2 class={heading}>{t.information}</h2>
        <ul class="space-y-1">
          <li>
            <a href={localizedPath(paths.donate, lang)} class={link}>
              {t.donate}
            </a>
          </li>

          <!-- Japanese only, in every language (its exact wording) -->
          <li>
            <a
              href={paths.privacy}
              hreflang={lang === "ja" ? undefined : "ja"}
              class={link}
            >
              {t.privacyPolicy}
            </a>
          </li>
          <li>
            <a href={localizedPath(paths.credits, lang)} class={link}>
              {t.credits}
            </a>
          </li>
        </ul>
      </div>
      <div data-footer-contact>
        <h2 class={heading}>{t.contact}</h2>
        <!-- Always underlined, so the address reads as a link. -->
        <a
          href={`mailto:${site.contact.email}`}
          class="text-sm leading-6 break-all text-[#c7cbd3] underline underline-offset-4"
          data-contact-email
        >
          {site.contact.email}
        </a>
      </div>
    </div>

    <p class="mt-8 text-sm text-[#c7cbd3]">{copyright}</p>
  </div>
</footer>

<style>
  .site-footer :global([data-brand-symbol] circle) {
    fill: #f5f5f4;
  }
  .site-footer :global([data-brand-symbol] path) {
    fill: #27272a;
  }
</style>
