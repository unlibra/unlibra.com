---
// The brand, site navigation, and compact language/theme controls.
import BrandSymbol from "@/components/BrandSymbol.astro";
import Logotype from "@/components/layout/Logotype.astro";
import LanguageSwitcher from "@/components/layout/LanguageSwitcher.astro";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";
import SiteNavigation from "@/components/layout/SiteNavigation.astro";
import type { Locale } from "@/config/locales";
import { localizedPath, paths, type SitePath } from "@/config/site";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
  /** Paths of this page in each language, when it has both. */
  languagePaths?: Record<Locale, SitePath>;
}

const { lang, languagePaths } = Astro.props;
---

<header>
  <nav
    class="mx-auto flex h-16 max-w-7xl items-center bg-transparent px-4 sm:px-6 lg:px-8"
    aria-label={layoutMessages[lang].navigation.label}
  >
    <!-- Logo: on the left -->
    <a
      href={localizedPath(paths.home, lang)}
      class="flex shrink-0 items-center gap-2 outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >
      <BrandSymbol class="size-6" />
      <!-- The logotype's ink ("unlibra", ascent 16px, descent 1px at 20px)
           sits 1px below the middle of its 28px line: up 1px, its middle is
           the symbol's. -->
      <span class="-translate-y-px text-xl/7" data-site-name data-logotype>
        <Logotype />
      </span>
    </a>

    <div class="ml-auto flex items-center gap-1 sm:gap-2 lg:gap-3">
      <SiteNavigation lang={lang} variant="desktop" />
      <div class="hidden md:block" data-desktop-settings>
        <div
          class="flex items-center gap-1 sm:gap-2 lg:gap-3"
          data-site-settings
        >
          {languagePaths && (
            <LanguageSwitcher lang={lang} paths={languagePaths} />
          )}
          <ThemeToggle lang={lang} />
        </div>
      </div>
      <SiteNavigation lang={lang} variant="mobile" />
    </div>
  </nav>
</header>

<script>
  // Keep one set of controls and IDs; place it inside the modal on phones.
  const settings = document.querySelector<HTMLElement>("[data-site-settings]");
  const desktop = document.querySelector<HTMLElement>(
    "[data-desktop-settings]",
  );
  const mobile = document.querySelector<HTMLElement>("[data-mobile-settings]");
  if (!settings || !desktop || !mobile)
    throw new Error("header settings are incomplete");
  const desktopWidth = window.matchMedia("(min-width: 768px)");
  const placeSettings = () =>
    (desktopWidth.matches ? desktop : mobile).append(settings);
  placeSettings();
  desktopWidth.addEventListener("change", placeSettings);
</script>
