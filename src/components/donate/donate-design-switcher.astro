---
interface Props {
  selected: "cards" | "rows" | "current";
}
const { selected } = Astro.props;
const choices = [
  { value: "cards", label: "A：カード" },
  { value: "rows", label: "B：ステップ" },
  { value: "current", label: "現在の表示" },
] as const;
---

<nav aria-label="デザイン案の比較" class="design-switcher">
  <span class="text-sm/6 text-gray-600 dark:text-gray-300">デザイン比較</span>
  <div class="flex flex-wrap gap-1">
    {choices.map(({ value, label }) => (
      <a
        href={value === "current" ? "/donate" : `/donate-preview/${value}`}
        aria-current={selected === value ? "page" : undefined}
        data-button
      >
        {label}
      </a>
    ))}
  </div>
</nav>
<style>
  .design-switcher {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-bottom: 32px;
    padding: 12px 16px;
    border: 1px solid var(--color-gray-200);
    border-radius: 8px;
    background: var(--color-gray-50);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
  }
  a:hover {
    background: var(--color-gray-100);
  }
  a[aria-current] {
    color: white;
    background: var(--color-primary);
  }
  a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  :global(.dark) .design-switcher {
    border-color: var(--color-gray-600);
    background: var(--color-atom-one-dark-light);
  }
  :global(.dark) a:hover:not([aria-current]) {
    background: var(--color-atom-one-dark-lighter);
  }
</style>
