---
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import WorkList from "@/components/works/WorkList.astro";
import type { Locale } from "@/config/locales";
import { localizedPath, paths, site } from "@/config/site";
import { toolIds } from "@/config/tools";
import { works } from "@/config/works";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { messages } from "@/messages";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = messages[lang].lab;
const labWorks = toolIds.map((id) => {
  const work = works.find((work) => work.id === id && work.category === "apps");
  if (!work) throw new Error(`Lab tool has no Apps card: ${id}`);
  return work;
});
---

<BaseLayout
  lang={lang}
  title={`${t.title} - ${site.title}`}
  description={t.description}
  canonical={true}
  pagePath={paths.tools}
>
  <main
    class="mx-auto w-full max-w-7xl px-4 pt-8 pb-12 sm:px-6 lg:px-8"
    data-lab-index
  >
    <Breadcrumb
      siteUrl={site.url}
      label={layoutMessages[lang].breadcrumb.label}
      items={[
        {
          label: layoutMessages[lang].breadcrumb.home,
          href: localizedPath(paths.home, lang),
        },
        { label: t.title },
      ]}
    />
    <div class="mb-12 space-y-4">
      <h1 class="text-[1.75rem]/11 font-semibold">{t.title}</h1>
      <p class="max-w-2xl leading-7 text-gray-600 dark:text-gray-400">
        {t.description}
      </p>
    </div>
    <section aria-labelledby="lab-tools">
      <h2 id="lab-tools" class="mb-6 text-xl font-semibold">
        {t.tools}
      </h2>
      <WorkList lang={lang} category="apps" works={labWorks} />
    </section>
  </main>
</BaseLayout>
