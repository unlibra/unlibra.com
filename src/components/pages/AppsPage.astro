---
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import WorkList from "@/components/works/WorkList.astro";
import type { Locale } from "@/config/locales";
import { localizedPath, paths, site } from "@/config/site";
import { toolIds } from "@/config/tools";
import { works, type WorkId } from "@/config/works";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { messages } from "@/messages";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = messages[lang].appsIndex;
/** The Apps cards of some works, all as list cards (Just HEX is a large card on the top page only). */
const appCards = (ids: readonly WorkId[]) =>
  ids.map((id) => {
    const work = works.find(
      (work) => work.id === id && work.category === "apps",
    );
    if (!work) throw new Error(`Apps index has no Apps card: ${id}`);
    return { ...work, featured: undefined };
  });
// Just HEX and the swatch book have their own pages at the site's root; the
// Apps index lists them apart from its tools under /apps, in the top page's order.
const rootApps = appCards(["just-hex", "color-palettes"]);
const browserTools = appCards(toolIds);
// The description, one sentence per line (the meta description keeps it in
// one line), as the top page's hero breaks between its sentences.
const sentences =
  lang === "en"
    ? t.description.split(/(?<=\.) /u)
    : t.description.split(/(?<=。)(?=.)/u);
---

<BaseLayout
  lang={lang}
  title={`${t.title} - ${site.title}`}
  description={t.description}
  canonical={true}
  pagePath={paths.tools}
>
  <main
    class="mx-auto w-full max-w-7xl px-4 pt-8 pb-12 sm:px-6 lg:px-8"
    data-apps-index
  >
    <Breadcrumb
      siteUrl={site.url}
      label={layoutMessages[lang].breadcrumb.label}
      items={[
        {
          label: layoutMessages[lang].breadcrumb.home,
          href: localizedPath(paths.home, lang),
        },
        { label: t.title },
      ]}
    />
    <!-- The page's name is in the breadcrumb on screen; the h1 stays for
         assistive technology and search engines. -->
    <div class="mb-12">
      <h1 class="sr-only">{t.title}</h1>
      <!-- Where a sentence wraps, at a phrase (auto-phrase, where the
           browser supports it). -->
      <p
        class="max-w-2xl leading-7 text-gray-600 [word-break:auto-phrase] dark:text-gray-400"
        data-apps-description
      >
        {sentences.map((sentence) => (
          <span class="block">{sentence}</span>
        ))}
      </p>
    </div>
    <section aria-labelledby="apps-web" class="mb-12">
      <h2 id="apps-web" class="mb-6 text-xl font-semibold">
        {t.webApps}
      </h2>
      <WorkList lang={lang} category="apps" works={rootApps} />
    </section>
    <section aria-labelledby="apps-tools">
      <h2 id="apps-tools" class="mb-6 text-xl font-semibold">
        {t.browserTools}
      </h2>
      <WorkList lang={lang} category="apps" works={browserTools} />
    </section>
  </main>
</BaseLayout>
