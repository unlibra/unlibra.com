---
// Just HEX: the top page (/hex, /en/hex) with the form, and the color
// screen (/hex/FFFFFF, /en/hex/FFFFFF), which fills the screen with the color and hides the header
// and the footer; a small dock at its bottom goes back, copies the link and
// shares it on X, and shows only while the pointer moves (see the script).
// The color screen's URL is the one to share: the Worker serves it with the
// color's OGP image (worker/index.ts). The top page's Share opens a dialog
// to share the input's color.
// The app is in English in both languages (lang="en" on its parts, not
// translated on the Japanese page); the page around it, the site's header
// and footer, is in the page's language. The color screen has no language
// switch: it shows nothing but the color and its dock.
//
// An art piece rather than a tool (the user's choice): the top page has the
// title, the input, the button and Share only, with no description; the
// input's placeholder is its only hint, and it starts with a random color.
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import BrandXIcon from "@/components/icons/BrandXIcon.astro";
import CheckIcon from "@/components/icons/CheckIcon.astro";
import LinkIcon from "@/components/icons/LinkIcon.astro";
import PaletteIcon from "@/components/icons/PaletteIcon.astro";
import ShareIcon from "@/components/icons/ShareIcon.astro";
import XIcon from "@/components/icons/XIcon.astro";
import { serializeJsonLd } from "@/components/ui/json-ld";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/config/locales";
import { profile } from "@/config/profile";
import { absoluteUrl, paths, site } from "@/config/site";
import { hexPath, hexPattern } from "@/tools/just-hex/hex";
import { hexMessages as t } from "@/tools/just-hex/messages";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
/** The top page in the page's language. */
const top = hexPath(lang);

const webApplication = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: t.name,
  description: t.description,
  url: absoluteUrl(top),
  applicationCategory: "DesignApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript. Requires HTML5.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "JPY",
  },
  author: {
    "@type": "Person",
    name: profile.name,
  },
  inLanguage: "en-US",
};

// The dock's buttons, 44px each, in the dock's color (its icons' color).
const dockButton =
  "flex size-11 cursor-pointer items-center justify-center rounded-full transition-colors outline-none hover:bg-current/15 focus-visible:outline-2 focus-visible:outline-current";

// The share dialog's buttons, 44px high, in the site's theme.
const dialogButton =
  "flex h-11 cursor-pointer items-center justify-center gap-2 rounded-full font-medium transition-colors outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-sora";
---

<BaseLayout
  lang={lang}
  title={`${t.name} - ${site.title}`}
  description={t.description}
  canonical={true}
  pagePath={paths.hex}
>
  {/* Before the first paint: a color in the path (/hex/FFFFFF), or in the
      hash of the top page (/hex#fff), hides the layout, so the header never
      flashes, and the address bar shows the color as /hex/FFFFFF. The module
      script below does the rest. */}
  <script
    slot="head"
    is:inline
    define:vars={{ pattern: hexPattern.source, top }}
  >
    document.documentElement.dataset.hexJs = "";
    const path = new RegExp(`^${top}/([^/]+)$`).exec(location.pathname);
    const code = path
      ? path[1]
      : location.pathname === top
        ? location.hash.slice(1)
        : "";
    const digits = new RegExp(pattern, "i").exec(code)?.[1]?.toUpperCase();
    if (digits) {
      const hex = digits.length === 3 ? digits.replace(/./g, "$&$&") : digits;
      // The entry's state (Show's fromTop) is kept.
      history.replaceState(history.state, "", `${top}/${hex}`);
      const root = document.documentElement;
      root.dataset.hex = "";
      root.style.setProperty("--hex", `#${hex}`);
    }
  </script>
  <div slot="screen" lang="en" class="fixed inset-0" data-hex-screen>
    <div
      role="group"
      aria-label={t.dock.label}
      class="fixed bottom-6 left-1/2 flex -translate-x-1/2 items-center gap-1 rounded-full bg-black/60 p-2 text-white shadow-md shadow-black/10 backdrop-blur-md data-[tone=dark]:bg-white/60 data-[tone=dark]:text-gray-900"
      data-hex-dock
    >
      <a
        href={top}
        class={dockButton}
        aria-label={t.dock.top}
        title={t.dock.top}
        data-hex-top
      >
        <PaletteIcon class="size-5" />
      </a>
      <button
        type="button"
        class:list={[dockButton, "group"]}
        aria-label={t.dock.copy}
        title={t.dock.copy}
        data-hex-copy
      >
        {/* A check for 2 seconds after copying (data-copied). */}
        <LinkIcon class="size-5 group-data-copied:hidden" />
        <CheckIcon class="hidden size-5 group-data-copied:block" />
      </button>
      <a
        class={dockButton}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.dock.share}
        title={t.dock.share}
        data-hex-share
      >
        <BrandXIcon class="size-5" />
      </a>
    </div>
    <span class="sr-only" role="status" data-hex-status></span>
  </div>

  <script
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(webApplication)}
  />
  <main
    lang="en"
    class="mx-auto w-full max-w-7xl px-4 pt-8 pb-12 sm:px-6 lg:px-8"
  >
    {/* The title, the input, the arrow and Share fade into view all at
        once, when the script has put the first color in (data-ready). */}
    <div
      class="flex min-h-[60dvh] flex-col items-center justify-center gap-12 py-12"
      data-hex-stage
    >
      <h1 class="text-center font-mono text-5xl/15 font-medium tracking-tight text-gray-900 sm:text-7xl/22 dark:text-white">
        {t.name}
      </h1>

      <div class="flex flex-col items-center gap-10">
        <form
          class="flex items-center gap-4"
          novalidate
          data-hex-form
          data-hex-locale={lang}
        >
          <div class="relative">
            <label for="hex-input" class="sr-only">
              {t.colorCode}
            </label>
            <input
              id="hex-input"
              type="text"
              maxlength="7"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder={t.placeholder}
              aria-describedby="hex-error"
              class="w-[7.5ch] rounded-none border-b-2 border-gray-300 bg-transparent pb-1 text-center font-mono text-3xl/10 text-gray-900 outline-none placeholder:text-gray-500 focus-visible:border-primary aria-invalid:border-red-600 dark:border-gray-600 dark:text-white dark:placeholder:text-gray-400 dark:focus-visible:border-sora dark:aria-invalid:border-red-400"
              data-hex-input
            />
            {/* Under the input, out of the flow: the page does not move
                when it shows. */}
            <p
              id="hex-error"
              role="alert"
              class="absolute top-full left-1/2 mt-2 -translate-x-1/2 text-sm whitespace-nowrap text-red-600 dark:text-red-400"
              data-hex-error
            ></p>
          </div>
          <button
            type="submit"
            aria-label={t.show}
            class="flex size-14 shrink-0 cursor-pointer items-center justify-center rounded-full bg-(--swatch) text-white transition-[color,background-color,scale] duration-200 outline-none motion-safe:hover:scale-108 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary data-[tone=light]:text-gray-900 data-empty:bg-transparent data-empty:text-gray-500 dark:data-empty:text-gray-400"
            data-hex-submit
            data-empty
          >
            <ArrowRightIcon class="size-6" />
          </button>
        </form>

        {/* Shares the input's color; not while it is no color. */}
        <button
          type="button"
          class="flex h-11 cursor-pointer items-center gap-2 rounded-full px-4 text-sm font-medium text-gray-600 transition-colors outline-none hover:bg-gray-100 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-primary disabled:cursor-default disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-gray-600 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-white dark:focus-visible:outline-sora dark:disabled:hover:text-gray-400"
          data-hex-share-open
        >
          <ShareIcon class="size-5" />
          {t.share.open}
        </button>
      </div>
    </div>
  </main>

  {/* The share dialog, in the site's theme: the share card (as the OGP of
      the color's URL shows) small in the middle, with room around it, on
      a gray (light) or dark ground that sets the card off, white or a
      lighter dark. The card shows the input's color (--share). No title
      on the dialog (its name is for screen readers). A click on the dialog
      element itself is on the backdrop. */}
  <dialog
    lang="en"
    aria-label={t.share.title}
    class="relative m-auto w-[calc(100%-2rem)] max-w-lg rounded-3xl bg-gray-100 p-0 text-gray-900 shadow-xl backdrop:bg-black/60 dark:bg-atom-one-dark dark:text-white"
    data-hex-dialog
  >
    {/* As far from the top as from the right: the icon 24px from both. */}
    <button
      type="button"
      aria-label={t.share.close}
      class="absolute top-3 right-3 flex size-11 cursor-pointer items-center justify-center rounded-full transition-colors outline-none hover:bg-gray-200 focus-visible:outline-2 focus-visible:outline-primary dark:hover:bg-white/10 dark:focus-visible:outline-sora"
      data-hex-dialog-close
    >
      <XIcon class="size-5" />
    </button>
    <div class="px-5 pt-16 pb-5 sm:px-6 sm:pb-6">
      {/* The card, as an OGP card shows on X: the color edge to edge on
          top (no bezel), the name and the URL under it, a thin border. And
          a shadow, which a card on X has not: it sets the card off from
          the dialog's ground, which is not X's. */}
      <div
        class="mx-auto w-3/5 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-md shadow-black/10 dark:border-white/10 dark:bg-atom-one-dark-lighter"
        data-hex-dialog-card
      >
        <div class="aspect-1200/630 bg-(--share)" data-hex-dialog-color></div>
        <div class="px-3 pt-2 pb-2.5">
          <p class="text-sm font-semibold">{t.name}</p>
          <p
            class="text-sm text-gray-500 dark:text-gray-400"
            data-hex-dialog-url
          ></p>
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-3">
        <button
          type="button"
          class:list={[
            dialogButton,
            "group border border-gray-300 hover:bg-gray-200 dark:border-gray-600 dark:hover:bg-white/10",
          ]}
          data-hex-dialog-copy
        >
          <LinkIcon class="size-5 group-data-copied:hidden" />
          <CheckIcon class="hidden size-5 group-data-copied:block" />
          <span class="group-data-copied:hidden">{t.share.copy}</span>
          <span class="hidden group-data-copied:inline">{t.copied}</span>
        </button>
        <a
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.share.x}
          class:list={[
            dialogButton,
            "bg-gray-900 text-white hover:bg-gray-700 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200",
          ]}
          data-hex-dialog-x
        >
          {t.share.xLabel}
          <BrandXIcon class="size-5" />
        </a>
      </div>
    </div>
    <span class="sr-only" role="status" data-hex-dialog-status></span>
  </dialog>
</BaseLayout>

<style is:global>
  /* The color screen: the color behind everything (the overscroll on
     phones too), in either theme, and nothing of the layout. */
  html[data-hex],
  html[data-hex] body {
    background-color: var(--hex);
  }

  html[data-hex] [data-layout],
  html:not([data-hex]) [data-hex-screen] {
    display: none;
  }

  /* The dock fades in while it is shown (data-dock on <html>, set by the
     script). Hidden, it takes no clicks, and the cursor hides too. */
  [data-hex-dock] {
    transition: opacity 0.2s;
  }

  html:not([data-dock]) [data-hex-dock] {
    opacity: 0;
    pointer-events: none;
  }

  html[data-hex]:not([data-dock]) {
    cursor: none;
  }

  /*
   * The input's color (--swatch, set on the stage by the script) on the
   * button. A registered color, so that it changes as a fade; without a
   * color it fades to transparent.
   */
  @property --swatch {
    syntax: "<color>";
    inherits: true;
    initial-value: transparent;
  }

  [data-hex-stage][data-ready] {
    transition: --swatch 0.4s;
  }

  /* Until the script has put the first color in, the title, the input, the
     arrow and Share are not shown: they appear all at once, colored. */
  html[data-hex-js] [data-hex-stage]:not([data-ready]) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* On opening, the title, the input, the arrow and Share fade softly
       into view from a blur, all at once, in 0.5s. */
    [data-hex-stage][data-ready] {
      animation: hex-fade 0.5s cubic-bezier(0.33, 1, 0.68, 1) both; /* easeOutCubic */
    }

    /* Not after a color: the color shrinks back into the button, already
       there. */
    html[data-hex-seen] [data-hex-stage] {
      animation: none;
    }

    /* A code that is not a color shakes the input. */
    [data-hex-input][data-shake] {
      animation: hex-shake 0.3s;
    }
  }

  @keyframes hex-fade {
    from {
      opacity: 0;
      filter: blur(8px);
    }
  }

  @keyframes hex-shake {
    25% {
      transform: translateX(-6px);
    }
    75% {
      transform: translateX(6px);
    }
  }
</style>

<script>
  import { site } from "@/config/site";
  import { startJustHex } from "@/tools/just-hex/just-hex";

  startJustHex(site);
</script>
