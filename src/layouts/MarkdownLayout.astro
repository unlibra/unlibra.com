---
// The layout of the pages of text: the privacy policy (Markdown, Japanese
// only) and the credits (in both languages).
import BaseLayout from "@/layouts/BaseLayout.astro";
import { locales, type Locale } from "@/config/locales";
import { site, type SitePath } from "@/config/site";

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
    /** The page's language: required, also in a Markdown file. */
    lang?: string;
    /** The page's Japanese path, for a page in both languages (BaseLayout). */
    pagePath?: SitePath;
  };
}

const { frontmatter } = Astro.props;
const { title, description, lang, pagePath } = frontmatter;
if (!title || !description) {
  throw new Error(
    `${Astro.url.pathname}: frontmatter needs both "title" and "description".`,
  );
}
if (!locales.includes(lang as Locale)) {
  throw new Error(
    `${Astro.url.pathname}: frontmatter needs "lang", one of ${locales.join(", ")}: ${lang}`,
  );
}
const siteTitle = `${title} - ${site.title}`;
---

<BaseLayout
  lang={lang as Locale}
  title={siteTitle}
  description={description}
  canonical={true}
  pagePath={pagePath}
>
  <!-- The same margins as the other pages (ui-revise12 6); the text keeps
       its width of max-w-3xl. -->
  <div class="px-4 pt-8 pb-12 sm:px-6 lg:px-8">
    <main class="prose mx-auto max-w-3xl">
      <slot />
    </main>
  </div>
</BaseLayout>

<style is:global>
  /*
   * Line heights (ui-revise7 5, 6): the size times the DADS ratio, rounded
   * up to a multiple of 4px. Headings 1.5 (28px -> 44px, 24px -> 36px,
   * 20px -> 32px), in 600 like the other headings; the h1 is the size of
   * the other pages' h1 (ui-revise12 3, 4); the text to read, paragraphs and list items, 1.7
   * (16px -> 28px).
   */
  .prose h1 {
    font-size: 1.75rem;
    line-height: 2.75rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .prose h2 {
    font-size: 1.5rem;
    line-height: 2.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    font-size: 1.25rem;
    line-height: 2rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.75rem;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose ul {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    list-style-type: disc;
  }

  .prose li {
    line-height: 1.75rem;
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  /*
   * Links: at least 4.5:1 with the page's background, at rest and on hover
   * (final-review 7), in the site's link colors (ui-revise13). Light on
   * white: link 5.0:1, hover 7.1:1. Dark on atom-one-dark: link-dark
   * 9.0:1, hover (lighter) 9.6:1.
   * Links drawn as buttons (data-button, the donate page) keep their own
   * colors.
   */
  .prose a:not([data-button]) {
    color: var(--color-link);
    text-decoration: underline;
  }

  .prose a:not([data-button]):hover {
    color: var(--color-link-hover);
  }

  .dark .prose a:not([data-button]) {
    color: var(--color-link-dark);
  }

  .dark .prose a:not([data-button]):hover {
    color: var(--color-link-dark-hover);
  }
</style>
